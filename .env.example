# Shared secret — same value typed into the app Data → Cloud sync
CATALOG_ACCESS_KEY=replace-with-a-long-random-string

# Supabase project
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use Legacy service_role (eyJ...) OR new Secret key (sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-sb-secret-key
